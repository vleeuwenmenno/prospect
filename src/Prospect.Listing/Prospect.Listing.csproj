<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>prospect-listing</AssemblyName>
    <RootNamespace>Prospect.Listing</RootNamespace>
    <!-- The listing server is plain managed code with no native libraries, so its image can run on any architecture. -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <!-- A small web service: the server collector would reserve far more memory than the list ever needs. -->
    <ServerGarbageCollector>false</ServerGarbageCollector>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Prospect.Listing.Tests" />
  </ItemGroup>
</Project>
