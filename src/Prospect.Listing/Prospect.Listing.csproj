<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>prospect-listing</AssemblyName>
    <RootNamespace>Prospect.Listing</RootNamespace>
    <!-- SQLite supplies native runtime assets for both supported container architectures. -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <!-- A small web service: the server collector would reserve far more memory than the list ever needs. -->
    <ServerGarbageCollector>false</ServerGarbageCollector>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <InternalsVisibleTo Include="Prospect.Listing.Tests" />
    <!-- The game's account tests replace the fixed Discord endpoints with a fake provider, as these tests do. -->
    <InternalsVisibleTo Include="Prospect.Tests" />
  </ItemGroup>
</Project>
