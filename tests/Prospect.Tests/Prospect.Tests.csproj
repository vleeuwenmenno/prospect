<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Prospect.Server/Prospect.Server.csproj" />
    <ProjectReference Include="../../src/Prospect.Game/Prospect.Game.csproj" />
    <!-- The client's input routing, interface and world view, run headless (no window, no GPU). -->
    <ProjectReference Include="../../src/Prospect.Client/Prospect.Client.csproj" />
    <!-- The real listing server, run in the test process, so the game's side of the contract is tested against it. -->
    <ProjectReference Include="../../src/Prospect.Listing/Prospect.Listing.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Ahwoo.BRUTAL.Glfw" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../content/**/*" LinkBase="content" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="fixtures/**/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
